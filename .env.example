REACT_APP_SANITY_PROJECT_ID=your_project_id
REACT_APP_SANITY_DATASET=production
REACT_APP_SANITY_TOKEN=your_sanity_token

# Spotify Now Playing
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token

# Google Gemini Neural Bridge & Embeddings
GEMINI_API_KEY=your_gemini_api_key
REACT_APP_GEMINI_API_KEY=your_gemini_api_key

# GroqCloud Ultra-Low Latency LPU Engine (Llama 3.3 70B)
GROQ_API_KEY=your_groq_api_key
REACT_APP_GROQ_API_KEY=your_groq_api_key

# Hugging Face Open-Weight Serverless Inference (Qwen 2.5 Coder, Mistral 7B, Llama 3.2)
HUGGINGFACE_API_KEY=your_huggingface_access_token
HF_TOKEN=your_huggingface_access_token

# OpenRouter API (Ultimate Global Failover Engine)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Mini-Adhy Backend API URL (Frontend Client)
REACT_APP_BACKEND_URL=http://127.0.0.1:3001

# ════════════════════════════════════════════════════════════════════
# BACKEND SERVER-SIDE ONLY (Never prefix with REACT_APP_)
# ════════════════════════════════════════════════════════════════════
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://adhy.tech


